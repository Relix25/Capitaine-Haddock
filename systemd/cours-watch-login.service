[Unit]
Description=Private browser login desktop for UPB course monitor
After=network-online.target
Conflicts=cours-watch.service

[Service]
Type=simple
User=courswatch
Group=courswatch
WorkingDirectory=/opt/cours-watch
ExecStart=/opt/cours-watch/login-desktop.sh
ExecStopPost=/usr/bin/rm -f /var/lib/cours-watch/login.active
UMask=0077
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cours-watch
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=3G
TasksMax=256
